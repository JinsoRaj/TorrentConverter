# Copy this file to .env and fill it in:  cp .env.example .env

# Required: your bot token from @BotFather
BOT_TOKEN = "123456789:your-bot-token-from-BotFather"

# Optional: your numeric Telegram user id. Enables the owner-only /stats and /broadcast.
# (Get it from @userinfobot.)
OWNER_ID = ""

# Optional: a channel or group for bot logs (new users, new groups, errors,
# broadcast reports). Add the bot there as an admin. Looks like -1001234567890.
LOG_CHAT_ID = ""

# ── Optional tuning (defaults shown) ────────────────────────────────────────

# Broadcast speed in messages per second (1-30; Telegram allows about 30/s)
# BROADCAST_RATE = 20

# Seconds to search for a magnet's metadata before giving up (10-600)
# METADATA_TIMEOUT = 60

# Magnet lookups running at the same time; extra ones wait in a queue (1-100)
# MAX_CONCURRENT_JOBS = 5

# Conversions one user can have in progress at once (1-50)
# MAX_JOBS_PER_USER = 2

# UDP port for the DHT node. 0 = random. Use a fixed port and open it in your
# firewall (e.g. `sudo ufw allow 6881/udp`) for faster, healthier lookups.
# DHT_PORT = 0

# Extra trackers used to find peers (comma separated, udp:// or http(s)://)
# EXTRA_TRACKERS = "udp://tracker.example.org:1337/announce"

# debug | info | warn | error
# LOG_LEVEL = info

# Where the bot keeps its database (bot.db) and DHT cache (relative to the project)
# DATA_DIR = data
