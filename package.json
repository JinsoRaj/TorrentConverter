{
  "name": "torrentconverter",
  "description": "A Telegram bot to convert torrent files to magnet links and magnet links to torrent files",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "dev": "node --watch bot.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JinsoRaj/TorrentConverter.git"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "torrent",
    "magnet",
    "bittorrent",
    "grammy"
  ],
  "author": "JinsoRaj",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JinsoRaj/TorrentConverter/issues"
  },
  "homepage": "https://github.com/JinsoRaj/TorrentConverter#readme",
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/runner": "^2.0.3",
    "bencode": "^4.0.1",
    "bittorrent-dht": "^11.0.12",
    "bittorrent-protocol": "^5.0.9",
    "grammy": "^1.46.0",
    "parse-torrent": "^11.0.24",
    "ut_metadata": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
